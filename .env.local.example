# ── Sketchroom environment variables ─────────────────────────────────────
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` — it contains secrets. All Convex-side vars are set with
# `npx convex env set NAME` instead; only `VITE_*` vars live in `.env.local`.

# ── Convex (required to run the app) ─────────────────────────────────────
# The deployment slug, e.g. "happy-hippo-123" (run `npx convex dev` to create).
CONVEX_DEPLOYMENT=dev

# The Convex backend URL shown by `npx convex dev` / the dashboard.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# The site origin Convex Auth redirects to (also the JWT issuer domain in
# convex/auth.config.ts). Use your deployed domain in production.
VITE_CONVEX_SITE_URL=http://localhost:5173
CONVEX_SITE_URL=http://localhost:5173

# ── tldraw license (optional; without it tldraw shows a license warning) ──
# 100-day trial key from https://tldraw.dev/setup/licensing. Client-side var:
# tldraw validates it in the browser, so it ships in the JS bundle.
# VITE_TLDRAW_LICENSE_KEY=tldraw-<date>/<payload>

# ── AI copilot (optional; without this the copilot says it isn't configured) ──
# OpenRouter API key. Server-side secret — set with `npx convex env set OPENROUTER_API_KEY`.
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter model id (defaults to google/gemma-4-26b-a4b-it:free if unset).
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# The site origin sent to OpenRouter for attribution (defaults to sketchroom.app).
# SITE_URL=http://localhost:5173

# ── Email (optional; enables verification codes + password reset) ─────────
# Resend API key. Server-side secret — `npx convex env set AUTH_RESEND_KEY`.
# AUTH_RESEND_KEY=re_...

# "From" address for auth + invite emails.
# AUTH_EMAIL_FROM=Sketchroom <onboarding@resend.dev>

# ── Google sign-in (optional; enables "Continue with Google") ────────────
# OAuth client credentials. Server-side secrets — set via `npx convex env set`.
# AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-client-secret

# ── Sentry (optional; enables error tracking + performance monitoring) ──
# Client-side DSN for the browser SDK. Find it in Sentry project settings.
# VITE_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

# Environment label sent to Sentry (default: "development").
# VITE_ENVIRONMENT=production

# App version (shown in Sentry release tags).
# VITE_APP_VERSION=1.0.0

# Sentry CLI / Vite plugin vars (server-side, for source-map uploads):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...
