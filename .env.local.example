# Copy to .env.local and fill in real values (see README.md).
# Convex: from `npx convex dev` / the Convex dashboard.
VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_CONVEX_SITE_URL=https://your-project.convex.site

# Public site URL. Used at BUILD time to emit the canonical link, og:url and
# sitemap.xml (robots.txt gets a Sitemap line). Leave unset for local dev —
# the tags are simply omitted, nothing placeholder ships. Set to your real
# production domain before deploying, e.g.:
# VITE_SITE_URL=https://sketchroom.app

# Auth (Convex Auth) — set these on the Convex deployment with
# `npx convex env set`, not in this file. The auth screen hides the
# corresponding controls until the secrets are present.
#   SITE_URL                     # e.g. https://sketchroom.app (OAuth/redirect validation)
#   AUTH_RESEND_KEY              # Resend API key → enables email verification + password reset
#   AUTH_EMAIL_FROM              # optional sender override (default: Sketchroom <onboarding@resend.dev>)
#   AUTH_GOOGLE_ID               # Google OAuth client id → enables "Continue with Google"
#   AUTH_GOOGLE_SECRET           # Google OAuth client secret
